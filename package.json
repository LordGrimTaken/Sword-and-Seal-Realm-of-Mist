{
  "name": "jiuzhou",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "JIUZHOU - release tooling and one-command launcher",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "play": "node scripts/play.mjs",
    "build:server": "node scripts/build-server.mjs",
    "package": "node scripts/package.mjs",
    "release:notes": "node scripts/make-releases.mjs",
    "electron:dist": "npm --prefix client run dist",
    "launcher:dev": "node launcher/scripts/dev.mjs",
    "launcher:dist": "npm --prefix launcher run dist",
    "release": "node scripts/make-release.mjs",
    "launcher:test": "node --test \"launcher/test/*.test.mjs\""
  }
}

