{
  "name": "jiuzhou-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Authoritative game server for JIUZHOU",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "tsx scripts/bots.ts && tsx scripts/economy.ts && tsx scripts/api-test.ts",
    "test:economy": "tsx scripts/economy.ts",
    "test:api": "tsx scripts/api-test.ts",
    "soak": "tsx scripts/soak.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
